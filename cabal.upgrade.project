import: ./project-stackage/nightly-2025-12-30.config

-- We have upgraded 7 packages and have 1 yet to do.
packages:
    persistent
  , persistent-mongoDB
  , persistent-postgresql
  , persistent-qq
  , persistent-redis
  , persistent-sqlite
  , persistent-test

-- Version equality constraints.
constraints:
    mongoDB ==2.7.1.4
  , resource-pool ==0.4.0.0
  , cryptohash ==0.11.9
  , cryptonite ==0.30
  , mysql ==0.2.1
  , mysql-simple ==0.4.9
program-options
  ghc-options: -fhide-source-paths

